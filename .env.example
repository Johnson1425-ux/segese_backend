# Copy to .env and fill in. Never commit the real .env.

# --- Required: the server refuses to start without these ---
MONGODB_URI=mongodb://127.0.0.1:27017/segese
JWT_SECRET=replace-with-a-long-random-string

# --- Core ---
NODE_ENV=development
PORT=5000
# Token lifetime; defaults to 8h if unset.
JWT_EXPIRE=8h
# Used to build verification and password-reset links, and for CORS.
FRONTEND_URL=http://localhost:3000

# --- Rate limiting (global API limiter) ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Email (Resend) ---
RESEND_API_KEY=
FROM_EMAIL=noreply@example.com
FROM_NAME=Segese Medical Clinic

# --- Payments (only needed if the Stripe gateway is wired up) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Clinic details used in email templates ---
CLINIC_NAME=Segese Medical Clinic
CLINIC_ADDRESS=
CLINIC_PHONE=

# --- Used only by `npm run setup-admin` (not read by the server) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
LOG_LEVEL=info
